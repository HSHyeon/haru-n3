    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
